process launch -- "/Volumes/Base Photos/Light/2019-05-18/L16_03434.lri" "/Volumes/Dev/L16_Lumen_ReverseEngineering/runs/denoise_route_census/unit1_70mm_cnr_formula.hdr" --profile 3 --export-fmt 3 --no-auto-lris
