process launch -- "/Volumes/Base Photos/Light/2018-12-26/L16_03041.lri" "/Volumes/Dev/L16_Lumen_ReverseEngineering/runs/denoise_route_census/unit1_35mm_cnr.hdr" --profile 3 --export-fmt 3 --no-auto-lris
