process launch -- "/Volumes/Base Photos/Light/2018-07-23/L16_02130.lri" "/Volumes/Dev/L16_Lumen_ReverseEngineering/runs/codex_final_compositing_switch_census/switch_census_28mm.hdr" --profile 3 --export-fmt 3 --no-auto-lris
