command script import /Users/ryaker/Dev/L16_Lumen_ReverseEngineering/tools/lldb_probes/codex_iramp_count_use_validation/count_use_probe.py
script count_use_probe.reset("70mm L16_03434 Codex IRAMP count-use validation", 16)
settings set target.env-vars DYLD_FRAMEWORK_PATH=/Users/ryaker/Documents/Light_Work/Lumen/Lumen.app/Contents/Frameworks DYLD_LIBRARY_PATH=/Users/ryaker/Documents/Light_Work/Lumen/Lumen.app/Contents/Frameworks
platform shell mkdir -p /Users/ryaker/Dev/L16_Lumen_ReverseEngineering/runs/codex_iramp_count_use_validation
target create /Volumes/Dev/L16_Lumen_ReverseEngineering/tools/lri_process
process handle SIGSEGV -p true -s false -n false
breakpoint set --shlib libcp.dylib --address 0x366a65
script count_use_probe.attach_existing(lldb.debugger)
process launch -- "/Volumes/Base Photos/Light/2019-05-18/L16_03434.lri" "/Users/ryaker/Dev/L16_Lumen_ReverseEngineering/runs/codex_iramp_count_use_validation/iramp_count_use_70mm.hdr" --profile 3 --export-fmt 3 --no-auto-lris
