target create /Users/ryaker/Documents/Light_Work/Lumen/Lumen.app/Contents/Frameworks/libcp.dylib

# Generic executor dispatch helpers used by the inspected callback objects.
image lookup -a 0x5440
image lookup -a 0x5670
disassemble --start-address 0x5440 --end-address 0x56d0
disassemble --start-address 0x5670 --end-address 0x58e0

# Callback vtable/address-point memory. Slot +0x30 is the substantive worker
# entry used by the generic callback dispatch shape in this bundle family.
