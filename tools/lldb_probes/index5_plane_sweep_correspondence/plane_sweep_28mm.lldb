command script import /Volumes/Dev/L16_Lumen_ReverseEngineering/tools/lldb_probes/index5_plane_sweep_correspondence/plane_sweep_correspondence_probe.py
script plane_sweep_correspondence_probe.reset("Unit-1 28mm index-5 plane-sweep correspondence", "/Volumes/Dev/L16_Lumen_ReverseEngineering/runs/index5_plane_sweep_correspondence/unit1_28mm", 752)
settings set target.env-vars DYLD_FRAMEWORK_PATH=/Users/ryaker/Documents/Light_Work/Lumen/Lumen.app/Contents/Frameworks DYLD_LIBRARY_PATH=/Users/ryaker/Documents/Light_Work/Lumen/Lumen.app/Contents/Frameworks
target create /private/tmp/lri_process_index5_correspondence
