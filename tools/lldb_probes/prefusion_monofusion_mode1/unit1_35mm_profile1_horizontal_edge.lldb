platform shell mkdir -p /Users/ryaker/Dev/L16_Lumen_ReverseEngineering/runs/prefusion_monofusion_mode1/horizontal_edge
target create /Volumes/Dev/L16_Lumen_ReverseEngineering/tools/lri_process
