command script import /Volumes/Dev/L16_Lumen_ReverseEngineering/tools/lldb_probes/state_helpers_23c5f0_f33d0_runtime/state_helper_probe.py
script state_helper_probe.reset("35mm L16_03041 state helpers 23c5f0/f33d0", 2048, 4096)
settings set target.env-vars DYLD_FRAMEWORK_PATH=/Users/ryaker/Documents/Light_Work/Lumen/Lumen.app/Contents/Frameworks DYLD_LIBRARY_PATH=/Users/ryaker/Documents/Light_Work/Lumen/Lumen.app/Contents/Frameworks
platform shell mkdir -p /Volumes/Dev/L16_Lumen_ReverseEngineering/runs/state_helpers_23c5f0_f33d0_runtime
target create /Volumes/Dev/L16_Lumen_ReverseEngineering/tools/lri_process
process handle SIGSEGV -p true -s false -n false
breakpoint set --shlib libcp.dylib --address 0x23c5f0
breakpoint set --shlib libcp.dylib --address 0xf33d0
script state_helper_probe.attach_existing(lldb.debugger)
process launch -- "/Volumes/Base Photos/Light/2018-12-26/L16_03041.lri" "/Volumes/Dev/L16_Lumen_ReverseEngineering/runs/state_helpers_23c5f0_f33d0_runtime/state_helper_35mm.hdr" --profile 3 --export-fmt 3 --no-auto-lris
script state_helper_probe.drive_until_exit_or_step_cap(lldb.debugger, 60000)
script state_helper_probe.write_report(lldb.debugger, "/Volumes/Dev/L16_Lumen_ReverseEngineering/runs/state_helpers_23c5f0_f33d0_runtime/state_helper_35mm.json")
